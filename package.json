{
  "name": "relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev:ui": "node scripts/dev-ui.mjs",
    "check": "tsc --noEmit",
    "build": "bash scripts/build.sh",
    "test": "npm run build && node --import tsx --test --test-timeout=65000 tests/*.test.ts",
    "typecheck": "npm run check",
    "verify": "npm run check && npm test",
    "atlas:smoke": "node dist/atlas-smoke.js",
    "pi:smoke": "node dist/pi-smoke.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.2",
      "minimatch": "11.0.1"
    }
  }
}
