# Relay server-side API key and independent internal bearer credential.
# Generate a new internal credential with: openssl rand -hex 32
RELAY_ACCESS_TOKEN=replace-with-a-random-token-from-openssl-rand-hex-32
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
RELAY_MODEL=poolside/laguna-s-2.1:free
RELAY_MAX_ACTIVE=1

# For the public hostname ONLY (./scripts/deploy.sh --tunnel):
# RELAY_BASIC_AUTH_USER=your-username
# Generate a password hash with: docker run --rm -it caddy:2-alpine caddy hash-password
# IMPORTANT: single-quote the bcrypt hash in .env so Docker Compose preserves dollar signs.
# RELAY_BASIC_AUTH_HASH='$2a$14$YOUR_HASH_HERE'
# TUNNEL_TOKEN=your-cloudflare-tunnel-token
