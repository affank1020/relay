# Never commit real keys or credentials.
RELAY_ACCESS_TOKEN=replace-with-a-random-token-from-openssl-rand-hex-32
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
RELAY_MODEL=cohere/north-mini-code:free
# Optional MacBook inference via private Tailscale Serve; models are discovered automatically.
RELAY_OLLAMA_URL=
# Optional legacy seed list while the Mac is offline (not needed for discovery).
RELAY_OLLAMA_MODELS=
RELAY_MAX_ACTIVE=1

# The Atlas Caddy ingress reuses ATLAS_ADMIN_USER/ATLAS_ADMIN_PASSWORD_HASH.
# Relay does not need a Tunnel token or a second Basic Auth password.

# Optional Relay -> Atlas service-to-service MCP. Atlas must enable the
# matching ATLAS_MCP_RELAY_TOKEN_SHA256 digest on its own VPS environment.
# Generate ATLAS_MCP_TOKEN privately with: openssl rand -hex 32
ATLAS_MCP_URL=
ATLAS_MCP_TOKEN=
# Optional Atlas Web origin for trusted navigation links; not an MCP endpoint.
# HTTPS origin only, no path/query/credentials (e.g. https://atlas.example.com).
ATLAS_WEB_ORIGIN=

# Optional. GitHub's remote MCP endpoint uses a server-side read-scoped PAT.
# No GitHub connection is enabled automatically; opt in through Relay settings.
RELAY_GITHUB_TOKEN=
# Pi's built-in MCP read transport (experimental until credentialed root/child smoke passes).
# Starts disabled; write approvals continue through the existing Relay policy path.
RELAY_PI_NATIVE_MCP=0
# Experimental: use pinned Pi subagents extension for tool-less child analyses.
# When enabled, Relay's legacy relay_delegate tool is not available.
RELAY_PI_SUBAGENTS=0
# Operator-approved GitHub issue/comment writes (up to 8 exact repositories).
# Empty means no write tool exposure, even with a write-capable PAT.
# Example: RELAY_GITHUB_WRITE_REPOS=affank1020/relay,affank1020/atlas
RELAY_GITHUB_WRITE_REPOS=
# Optional operator-reviewed extra HTTPS MCP providers, with explicit read-only
# tool names and tokenEnv keys such as RELAY_MCP_TOKEN_CUSTOM. No write tools.
RELAY_MCP_PROVIDERS=[]
RELAY_MCP_HOST_ALLOWLIST=
