# Generate a long, random Relay UI/API token with: openssl rand -hex 32
RELAY_ACCESS_TOKEN=replace-with-a-random-token-from-openssl-rand-hex-32
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# Free models only during testing. Non-:free model IDs are rejected.
RELAY_MODEL=poolside/laguna-s-2.1:free
RELAY_MAX_ACTIVE=1

# Optional: Cloudflare Tunnel token (required only for ./scripts/deploy.sh --tunnel).
# Create tunnel + Access policy in the Cloudflare dashboard; see docs/deployment.md.
# TUNNEL_TOKEN=eyJ...
