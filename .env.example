# Never commit real keys or credentials.
RELAY_ACCESS_TOKEN=replace-with-a-random-token-from-openssl-rand-hex-32
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
RELAY_MODEL=poolside/laguna-s-2.1:free
RELAY_MAX_ACTIVE=1

# The Atlas Caddy ingress reuses ATLAS_ADMIN_USER/ATLAS_ADMIN_PASSWORD_HASH.
# Relay does not need a Tunnel token or a second Basic Auth password.
