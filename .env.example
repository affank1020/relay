# Never commit real keys or credentials.
RELAY_ACCESS_TOKEN=replace-with-a-random-token-from-openssl-rand-hex-32
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
RELAY_MODEL=poolside/laguna-s-2.1:free
RELAY_MAX_ACTIVE=1

# The Atlas Caddy ingress reuses ATLAS_ADMIN_USER/ATLAS_ADMIN_PASSWORD_HASH.
# Relay does not need a Tunnel token or a second Basic Auth password.
\n# Optional Relay -> Atlas machine-to-machine OAuth; enable after Atlas service-identity PR deploys.
# The issuer must be the exact Auth0 tenant URL, ending in /.
# The audience/URL must match Atlas's configured ATLAS_MCP_RESOURCE.
ATLAS_MCP_URL=
ATLAS_OAUTH_ISSUER=
ATLAS_OAUTH_CLIENT_ID=
ATLAS_OAUTH_CLIENT_SECRET=
# Legacy static bearer fallback; do not set at the same time as OAuth.
ATLAS_MCP_TOKEN=
