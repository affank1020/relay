# Never commit real keys or credentials.
RELAY_ACCESS_TOKEN=replace-with-a-random-token-from-openssl-rand-hex-32
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
RELAY_MODEL=cohere/north-mini-code:free
# Optional MacBook inference via Tailscale Serve; exact model IDs from ollama list.
RELAY_OLLAMA_URL=
RELAY_OLLAMA_MODELS=
RELAY_MAX_ACTIVE=1

# The Atlas Caddy ingress reuses ATLAS_ADMIN_USER/ATLAS_ADMIN_PASSWORD_HASH.
# Relay does not need a Tunnel token or a second Basic Auth password.

# Optional Relay -> Atlas service-to-service MCP. Atlas must enable the
# matching ATLAS_MCP_RELAY_TOKEN_SHA256 digest on its own VPS environment.
# Generate ATLAS_MCP_TOKEN privately with: openssl rand -hex 32
ATLAS_MCP_URL=
ATLAS_MCP_TOKEN=
